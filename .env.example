# URL base de la API utilizada por la interfaz.
VITE_API_URL=http://localhost:3000/api

# Clave de API de OpenWeather (requerida por la vista de clima en src/App.tsx)
# Obtenla en https://openweathermap.org/api (plan gratuito) y pégala aquí.
VITE_OPENWEATHER_API_KEY=

# Puerto de escucha de la API (opcional; valor predeterminado: 3000).
PORT=3000

# Orígenes permitidos por CORS separados por comas (opcional).
# Si se omite, se permiten los puertos locales 5173 y 5174.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
